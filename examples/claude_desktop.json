{
  "mcpServers": {
    "higgsfield": {
      "command": "uv",
      "args": ["run", "--directory", "/path/to/higgsfield-mcp-unified", "higgsfield-mcp"],
      "env": {
        "HIGGSFIELD_API_KEY": "your-key-id",
        "HIGGSFIELD_SECRET": "your-key-secret",

        "_comment": "Optional: rename the two keys below (drop the '// ') to enable the experimental web backend (Sora 2, Veo 3, Nano Banana, ...). Read the README first.",
        "// HIGGSFIELD_ENABLE_WEB_BACKEND": "1",
        "// HIGGSFIELD_CLERK_CLIENT": "paste-your-__client-cookie-here"
      }
    }
  }
}
